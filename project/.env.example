# Hardware-aware defaults (mid-end safe)
DEVICE=cpu
MAX_SAMPLES=1000
BATCH_SIZE=8
MAX_LENGTH=256

# Optional LLM provider settings (leave blank if unused)
OPENAI_API_KEY=
HF_API_KEY=
