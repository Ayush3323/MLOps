# App
APP_NAME=Review Intelligence API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Paths
MODEL_PATH=./checkpoints/best-model
CHROMA_PATH=./chroma_db
MLFLOW_TRACKING_URI=./experiments/mlruns
