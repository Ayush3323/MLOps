# App
APP_NAME=Review Intelligence API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Paths (project/ is the working directory when you run uvicorn)
# Prefer the symlink checkpoints/best-model -> week3-distilbert/best-model
MODEL_PATH=./checkpoints/best-model
CHROMA_PATH=./chroma_db
MLFLOW_TRACKING_URI=./experiments/mlruns
PROCESSED_DATA_DIR=./data/processed

# Hardware-aware defaults (mid-end / CPU safe)
DEVICE=cpu
MAX_SAMPLES=1000
BATCH_SIZE=8
MAX_LENGTH=256

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_COLLECTION=product_reviews
RAG_TOP_K=5

# Optional LLM providers for /api/query generation.
# Leave blank to use extractive answers from retrieved reviews (no download).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
HF_API_KEY=
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
